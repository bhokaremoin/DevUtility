{
  "permissions": {
    "allow": [
      "Bash(harness status)",
      "Bash(harness status *)",
      "Bash(harness check)",
      "Bash(harness lessons)",
      "Bash(harness learn *)",
      "Bash(harness history)",
      "Bash(harness history *)",
      "Bash(harness where)",
      "Bash(python3 .claude/harness/review/pr_review.py *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v harness >/dev/null 2>&1 && harness check || true"
          },
          {
            "type": "command",
            "command": "command -v harness >/dev/null 2>&1 && harness lessons || true"
          }
        ]
      }
    ]
  }
}
